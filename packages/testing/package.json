{
  "name": "@pine-ui/testing",
  "version": "0.0.1",
  "description": "Shared testing utilities and harnesses for Pine UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.10.2",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  },
  "devDependencies": {
    "@pine-ui/tsconfig": "workspace:*"
  }
}
