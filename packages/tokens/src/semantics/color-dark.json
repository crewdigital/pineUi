{
  "background": {
    "$type": "color",
    "canvas": {
      "$value": "{color.neutral.950}",
      "$description": "Page canvas background in dark mode"
    },
    "surface": {
      "$value": "{color.neutral.900}",
      "$description": "Card / panel surface in dark mode"
    },
    "surfaceRaised": {
      "$value": "{color.neutral.800}",
      "$description": "Elevated modal/dropdown surface in dark mode"
    },
    "surfaceSubtle": {
      "$value": "{color.neutral.800}",
      "$description": "Subtle surface container in dark mode"
    },
    "surfaceMuted": {
      "$value": "{color.neutral.700}",
      "$description": "Muted background in dark mode"
    },
    "surfaceDisabled": {
      "$value": "{color.neutral.800}",
      "$description": "Disabled container background in dark mode"
    },
    "brand": {
      "$value": "{color.blue.500}",
      "$description": "Brand primary solid fill in dark mode"
    },
    "brandSubtle": {
      "$value": "{color.blue.950}",
      "$description": "Brand subtle tinted fill in dark mode"
    },
    "brandHover": {
      "$value": "{color.blue.400}",
      "$description": "Brand interactive hover in dark mode"
    },
    "brandActive": {
      "$value": "{color.blue.300}",
      "$description": "Brand interactive active in dark mode"
    }
  },
  "foreground": {
    "$type": "color",
    "primary": {
      "$value": "{color.neutral.50}",
      "$description": "High-emphasis text and icons in dark mode"
