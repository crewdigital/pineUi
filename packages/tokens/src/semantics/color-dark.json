      "$value": "{color.neutral.700}",
      "$description": "Standard container borders in dark mode"
    },
    "strong": {
      "$value": "{color.neutral.500}",
      "$description": "Emphasized interactive borders in dark mode"
    },
    "focus": {
      "$value": "{color.blue.400}",
      "$description": "Focused control border in dark mode"
    },
    "disabled": {
      "$value": "{color.neutral.800}",
      "$description": "Disabled element border in dark mode"
    }
  },
  "action": {
    "primary": {
      "$type": "color",
      "background": { "$value": "{color.blue.500}" },
      "backgroundHover": { "$value": "{color.blue.400}" },
      "backgroundActive": { "$value": "{color.blue.300}" },
      "foreground": { "$value": "{color.neutral.950}" }
    },
    "secondary": {
      "$type": "color",
      "background": { "$value": "{color.neutral.900}" },
      "backgroundHover": { "$value": "{color.neutral.800}" },
      "backgroundActive": { "$value": "{color.neutral.700}" },
      "foreground": { "$value": "{color.neutral.50}" },
      "border": { "$value": "{color.neutral.700}" }
    },
    "subtle": {
      "$type": "color",
      "background": { "$value": "transparent" },
      "backgroundHover": { "$value": "{color.neutral.800}" },
      "backgroundActive": { "$value": "{color.neutral.700}" },
      "foreground": { "$value": "{color.neutral.300}" }
    },
    "danger": {
      "$type": "color",
      "background": { "$value": "{color.red.500}" },
      "backgroundHover": { "$value": "{color.red.400}" },
      "backgroundActive": { "$value": "{color.red.300}" },
      "foreground": { "$value": "{color.neutral.950}" }
    }
  },
  "feedback": {
    "success": {
      "$type": "color",
      "background": { "$value": "{color.green.950}" },
      "border": { "$value": "{color.green.800}" },
      "foreground": { "$value": "{color.green.200}" },
      "solid": { "$value": "{color.green.500}" }
    },
    "warning": {
      "$type": "color",
      "background": { "$value": "{color.yellow.950}" },
      "border": { "$value": "{color.yellow.800}" },
      "foreground": { "$value": "{color.yellow.200}" },
      "solid": { "$value": "{color.yellow.500}" }
    },
    "danger": {
      "$type": "color",
      "background": { "$value": "{color.red.950}" },
      "border": { "$value": "{color.red.800}" },
      "foreground": { "$value": "{color.red.200}" },
      "solid": { "$value": "{color.red.500}" }
    },
    "info": {
      "$type": "color",
      "background": { "$value": "{color.blue.950}" },
      "border": { "$value": "{color.blue.800}" },
      "foreground": { "$value": "{color.blue.200}" },
      "solid": { "$value": "{color.blue.500}" }
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.blue.400}",
      "$description": "Keyboard focus indicator color in dark mode"
    },
    "offset": {
      "$value": "{color.neutral.950}",
      "$description": "Focus ring offset outline in dark mode"
    }
  }
