{
  "name": "@pine-ui/behaviors",
  "version": "0.0.1",
  "description": "Headless interaction, accessibility, and focus behaviors for Pine UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./create-scoped-context": {
      "types": "./dist/create-scoped-context/index.d.ts",
      "import": "./dist/create-scoped-context/index.js"
    },
    "./use-controllable-state": {
      "types": "./dist/use-controllable-state/index.d.ts",
      "import": "./dist/use-controllable-state/index.js"
    },
    "./aria-linking": {
      "types": "./dist/aria-linking/index.d.ts",
      "import": "./dist/aria-linking/index.js"
    },
    "./focus-trap": {
      "types": "./dist/focus-trap/index.d.ts",
      "import": "./dist/focus-trap/index.js"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "import": "./dist/portal/index.js"
    },
    "./dismiss": {
      "types": "./dist/dismiss/index.d.ts",
      "import": "./dist/dismiss/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pine-ui/testing": "workspace:*",
    "@pine-ui/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "sideEffects": false
}
